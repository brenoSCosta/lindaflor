{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "target": "ESNext",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "rootDirs": ["."],
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "moduleResolution": "bundler",
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@lindaflor/db/*": ["../../packages/db/src/*"],
      "@lindaflor/env/*": ["../../packages/env/src/*"],
      "@lindaflor/auth/*": ["../../packages/auth/src/*"],
      "@lindaflor/api/*": ["../../packages/api/src/*"],
      "@lindaflor/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [".agents", ".claude"]
}
