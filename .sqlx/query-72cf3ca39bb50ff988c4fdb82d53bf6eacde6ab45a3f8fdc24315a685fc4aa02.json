  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, name, email, email_verified, image, two_factor_enabled, role,\n               banned, ban_reason, ban_expires\n        FROM users\n        WHERE ($1 = '' OR name ILIKE $1 OR email ILIKE $1)\n        ORDER BY created_at DESC, id DESC\n        LIMIT $2 OFFSET $3\n        ",
