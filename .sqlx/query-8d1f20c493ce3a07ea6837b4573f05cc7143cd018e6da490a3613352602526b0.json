  "query": "SELECT pv.id, pv.sku, p.name AS product_name, pv.size::text AS \"size!\", pv.color\n       FROM product_variants pv\n       INNER JOIN products p ON p.id = pv.product_id\n       WHERE p.active = true\n       ORDER BY p.name ASC, pv.sku ASC LIMIT 200",
