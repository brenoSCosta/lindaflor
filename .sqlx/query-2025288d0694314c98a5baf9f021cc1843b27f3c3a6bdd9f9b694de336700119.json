{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            s.id AS session_id,\n            s.expires_at,\n            s.updated_at,\n            s.impersonated_by,\n            u.id AS user_id,\n            u.name,\n            u.email,\n            u.email_verified,\n            u.image,\n            u.two_factor_enabled,\n            u.role,\n            u.banned,\n            u.ban_reason,\n            u.ban_expires\n        FROM sessions s\n        INNER JOIN users u ON u.id = s.user_id\n        WHERE s.token = $1\n          AND s.expires_at > now()\n        ",
