{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            u.id,\n            u.name,\n            u.email,\n            u.email_verified,\n            u.image,\n            u.two_factor_enabled,\n            u.role,\n            u.banned,\n            u.ban_reason,\n            u.ban_expires,\n            a.password\n        FROM users u\n        INNER JOIN accounts a ON a.user_id = u.id AND a.provider_id = $2\n        WHERE u.email = $1\n        ",
