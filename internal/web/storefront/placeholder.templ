package storefront

import "github.com/wellington-vell/lindaflor/internal/web/components"

// placeholderHome stands in until wave2-D ports src/app.rs `page`.
templ placeholderHome() {
	@components.Container(components.ContainerProps{Variant: components.ContainerCentered}) {
		<h1 class="font-serif text-4xl">Linda Flor</h1>
		<p class="text-muted-foreground">Moda praia — loja em migração.</p>
		@components.LinkButton("/produtos", components.ButtonProps{}) {
			Ver catálogo
		}
	}
}
