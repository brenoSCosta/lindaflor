package storefront

import (
	"strconv"

	"github.com/wellington-vell/lindaflor/internal/store"
	"github.com/wellington-vell/lindaflor/internal/web/components"
	"github.com/wellington-vell/lindaflor/web/static"
)

// heroBanners is src/app/store/hero.rs: active banners as a scroll-snap
// carousel; nothing without slides (the page keeps its static hero).
templ heroBanners(slides []store.HeroSlide) {
	if len(slides) > 0 {
		<section class="relative" aria-label="Destaques">
			<div class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none]">
				for _, slide := range slides {
					<a href={ templ.URL(slide.LinkURL) } class="relative block h-[70vh] min-h-[420px] w-full shrink-0 snap-center overflow-hidden">
						<img src={ slide.ImageURL } alt={ slide.Title } class="absolute inset-0 h-full w-full object-cover"/>
						<div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent"></div>
						<div class="absolute inset-x-0 bottom-0 p-8 text-white md:p-16">
							<h2 class="font-serif text-4xl leading-tight md:text-6xl">{ slide.Title }</h2>
							if slide.Subtitle != nil {
								<p class="mt-3 max-w-xl text-base md:text-lg">{ *slide.Subtitle }</p>
							}
							<span class="mt-6 inline-block border border-white px-6 py-3 text-xs tracking-[0.2em] uppercase">{ slide.CTALabel }</span>
						</div>
					</a>
				}
			</div>
			if len(slides) > 1 {
				<p class="pointer-events-none absolute right-6 top-6 text-[10px] tracking-[0.2em] uppercase text-white/80">Deslize →</p>
			}
		</section>
	}
}

templ staticHero() {
	<section class="relative min-h-[85vh] overflow-hidden">
		<img
			src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=2000&q=80"
			alt=""
			class="absolute inset-0 h-full w-full object-cover"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-black/55 to-black/10"></div>
		<div class="relative mx-auto flex min-h-[85vh] max-w-7xl items-end px-4 pb-16 md:px-8 md:pb-24">
			<div class="max-w-xl space-y-6 text-white">
				<p class="text-[10px] tracking-[0.24em] text-white/75 uppercase">Coleção Verão 2026</p>
				<h1 class="font-serif text-5xl leading-tight md:text-6xl">Elegância tropical</h1>
				<p class="max-w-md text-sm leading-relaxed text-white/80 md:text-base">
					Peças pensadas para quem ama sol, mar e estilo. Do biquíni clássico à saída de praia perfeita, tudo com a assinatura Linda Flor.
				</p>
				<div class="flex flex-wrap gap-3 pt-2">
					<a href="/produtos" class={ components.ButtonVariants(components.ButtonPrimary, components.ButtonLg) }>
						Comprar agora
					</a>
					<a
						href="/#sobre"
						class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-white/50 px-5 text-base font-medium text-white transition-colors hover:bg-white/10"
					>
						Ver coleções
					</a>
				</div>
			</div>
		</div>
	</section>
}

templ homePage(d homeData) {
	<script src={ static.URL("js/sobre.js") } defer></script>
	@heroBanners(d.Slides)
	if !d.Sections.HasBanners {
		@staticHero()
	}
	<section class="mx-auto max-w-7xl px-4 py-8 md:px-8">
		<div class="grid gap-8 md:grid-cols-3">
			<div class="flex flex-col items-center text-center space-y-2">
				@components.Icon("truck", "")
				<h3 class="font-semibold text-sm">Frete grátis</h3>
				<p class="text-xs text-muted-foreground">{ freeShippingBenefit(d.Settings.FreeShippingThresholdCents) }</p>
			</div>
			if d.Settings.PixDiscountPercent > 0 {
				<div class="flex flex-col items-center text-center space-y-2">
					@components.Icon("percent", "")
					<h3 class="font-semibold text-sm">{ strconv.Itoa(d.Settings.PixDiscountPercent) }% OFF no Pix</h3>
					<p class="text-xs text-muted-foreground">Desconto imediato</p>
				</div>
			}
			<div class="flex flex-col items-center text-center space-y-2">
				@components.Icon("rotate-ccw", "")
				<h3 class="font-semibold text-sm">Troca fácil</h3>
				<p class="text-xs text-muted-foreground">Até 7 dias</p>
			</div>
		</div>
	</section>
	<section class="mx-auto max-w-7xl px-4 py-20 md:px-8">
		<div class="mb-10">
			<p class="text-[10px] tracking-widest text-primary uppercase">Categorias</p>
			<h2 class="font-serif mt-2 text-4xl text-foreground md:text-5xl">Explore a coleção</h2>
		</div>
		<div class="grid gap-4 md:grid-cols-3">
			for _, c := range homeCategories {
				<a href={ templ.SafeURL(c.Href) } class="group relative aspect-[4/5] overflow-hidden rounded-lg">
					<img src={ c.Image } alt={ c.Alt } class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
					<p class="absolute bottom-6 left-6 font-serif text-3xl text-white">{ c.Label }</p>
				</a>
			}
		</div>
	</section>
	if len(d.Sections.Lancamentos) > 0 {
		<section class="border-y border-border bg-foreground/5 px-4 py-20 md:px-8">
			<div class="mx-auto max-w-7xl">
				<div class="mb-12 flex items-end justify-between gap-6">
					<div>
						<p class="text-[10px] tracking-widest text-primary uppercase">Novidades</p>
						<h2 class="font-serif mt-2 text-4xl text-foreground md:text-5xl">Lançamentos</h2>
					</div>
					<a href="/produtos?sort=novos" class="hidden items-center gap-2 text-[10px] tracking-wider uppercase md:inline-flex">
						Ver tudo
					</a>
				</div>
				@productGrid("grid gap-8 sm:grid-cols-2 lg:grid-cols-4", d.Sections.Lancamentos, d.Cards)
			</div>
		</section>
	}
	if len(d.Sections.MaisVendidos) > 0 {
		<section class="mx-auto max-w-7xl px-4 py-20 md:px-8">
			<div class="mb-12 flex items-end justify-between gap-6">
				<div>
					<p class="text-[10px] tracking-widest text-primary uppercase">Populares</p>
					<h2 class="font-serif mt-2 text-4xl text-foreground md:text-5xl">Mais vendidos</h2>
				</div>
				<a href="/produtos?sort=mais_vendidos" class="hidden items-center gap-2 text-[10px] tracking-wider uppercase md:inline-flex">
					Ver tudo
				</a>
			</div>
			@productGrid("grid gap-8 sm:grid-cols-2 lg:grid-cols-4", d.Sections.MaisVendidos, d.Cards)
		</section>
	}
	if len(d.Sections.Liquida) > 0 {
		<section class="bg-red-50 dark:bg-red-950/20 px-4 py-20 md:px-8">
			<div class="mx-auto max-w-7xl">
				<div class="mb-12 flex items-end justify-between gap-6">
					<div>
						<p class="text-[10px] tracking-widest text-red-600 uppercase">Promoção</p>
						<h2 class="font-serif mt-2 text-4xl text-foreground md:text-5xl">Liquida</h2>
					</div>
					<a href="/produtos?sale=true" class="hidden items-center gap-2 text-[10px] tracking-wider uppercase text-red-600 md:inline-flex font-semibold">
						Ver mais
					</a>
				</div>
				@productGrid("grid gap-8 sm:grid-cols-2 lg:grid-cols-4", d.Sections.Liquida, d.Cards)
			</div>
		</section>
	}
	<section id="newsletter" class="border-y border-border px-4 py-16 md:px-8">
		<div class="mx-auto grid max-w-3xl gap-6 md:grid-cols-2 md:items-center">
			<div class="space-y-3">
				<p class="text-[10px] tracking-widest text-primary uppercase">Newsletter</p>
				<h2 class="font-serif text-3xl leading-tight text-foreground">Novidades e promoções no seu e-mail</h2>
				<p class="text-sm text-muted-foreground">Lançamentos, reposições e cupons exclusivos. Cancele quando quiser.</p>
			</div>
			@NewsletterForm()
		</div>
	</section>
	<section id="sobre" data-reveal class="mx-auto grid max-w-7xl scroll-mt-28 items-center gap-10 px-4 py-24 md:grid-cols-2 md:px-8">
		<div class="overflow-hidden rounded-2xl">
			<img
				src="https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=1400&q=80"
				alt="Praia em Aracaju"
				class="aspect-[4/5] w-full object-cover"
			/>
		</div>
		<div class="space-y-6" data-reveal style="transition-delay:120ms">
			<p class="text-[10px] tracking-widest text-primary uppercase">Nossa história</p>
			<h2 class="font-serif text-4xl leading-tight text-foreground md:text-5xl">
				Moda praia feita com carinho em Aracaju
			</h2>
			<p class="leading-relaxed text-muted-foreground">
				A Linda Flor nasceu para vestir mulheres que querem se sentir lindas na praia, na piscina e no pôr do sol. Qualidade no tecido, modelagem que valoriza o corpo e um atendimento próximo de quem entende moda praia de verdade.
			</p>
			<p class="text-[10px] tracking-wider text-primary uppercase">{ "@biquinislindaflor" }</p>
		</div>
	</section>
	<section class="border-t border-border bg-foreground px-4 py-16 text-center text-background md:px-8">
		<p class="text-[10px] tracking-[0.24em] uppercase">Atendimento personalizado</p>
		<h2 class="font-serif mt-3 text-4xl md:text-5xl">Fale com a gente no WhatsApp</h2>
		<p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-background/70">
			Tire dúvidas sobre tamanhos, cores e disponibilidade. Estamos em Aracaju, de segunda a sexta, das 9h às 18h.
		</p>
		if d.WhatsappURL != "" {
			<a
				href={ templ.SafeURL(d.WhatsappURL) }
				target="_blank"
				rel="noreferrer"
				class={ components.ButtonVariants(components.ButtonPrimary, components.ButtonLg, "mt-8") }
			>
				Chamar no WhatsApp
			</a>
		}
	</section>
}
