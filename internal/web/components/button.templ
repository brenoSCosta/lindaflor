package components

// ButtonVariant is the visual style of a button (default Primary).
type ButtonVariant int

const (
	ButtonPrimary ButtonVariant = iota
	ButtonSecondary
	ButtonOutline
	ButtonGhost
	ButtonDestructive
)

// ButtonSize is the button size (default Md).
type ButtonSize int

const (
	ButtonMd ButtonSize = iota
	ButtonSm
	ButtonLg
	ButtonIcon
)

const buttonBase = "inline-flex shrink-0 items-center justify-center border text-sm font-medium whitespace-nowrap transition-colors outline-none select-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 aria-disabled:opacity-50"

func (v ButtonVariant) classes() string {
	switch v {
	case ButtonSecondary:
		return "border-transparent bg-foreground/5 text-foreground shadow-xs hover:bg-foreground/10 active:bg-foreground/15"
	case ButtonOutline:
		return "border-border text-foreground hover:bg-foreground/5 active:bg-foreground/10"
	case ButtonGhost:
		return "border-transparent text-foreground hover:bg-foreground/5 active:bg-foreground/10"
	case ButtonDestructive:
		return "border-transparent bg-destructive text-destructive-foreground shadow-xs hover:bg-destructive/90 active:bg-destructive/80"
	default:
		return "border-transparent bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 active:bg-primary/80"
	}
}

func (s ButtonSize) classes() string {
	switch s {
	case ButtonSm:
		return "h-8 gap-1.5 rounded-md px-3"
	case ButtonLg:
		return "h-10 gap-2 rounded-lg px-5"
	case ButtonIcon:
		return "size-9 rounded-lg"
	default:
		return "h-9 gap-2 rounded-lg px-4"
	}
}

// ButtonVariants is the full class list of a button, for styling another
// element (e.g. <a class={ components.ButtonVariants(ButtonOutline, ButtonMd) }>).
func ButtonVariants(v ButtonVariant, s ButtonSize, extra ...string) string {
	return Cn(append([]string{buttonBase, v.classes(), s.classes()}, extra...)...)
}

type ButtonProps struct {
	Variant ButtonVariant
	Size    ButtonSize
	// Blocked marks an invalid state with aria-disabled while keeping the
	// button submittable (the server stays the source of truth).
	Blocked bool
	Class   string
	Attrs   templ.Attributes
}

// Button is a styled <button>. Pass "type" through Attrs.
templ Button(p ButtonProps) {
	<button class={ ButtonVariants(p.Variant, p.Size, p.Class) } aria-disabled={ boolStr(p.Blocked) } { attrs(p.Attrs)... }>
		{ children... }
	</button>
}

// LinkButton is an <a> styled as a button.
templ LinkButton(href templ.SafeURL, p ButtonProps) {
	<a href={ href } class={ ButtonVariants(p.Variant, p.Size, p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</a>
}
