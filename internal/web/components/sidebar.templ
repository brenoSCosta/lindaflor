package components

// Sidebar primitives (port of src/components/sidebar.rs). Client state
// lives in the Alpine "sidebar" component (web/static/js/components.js):
// SidebarProvider sets x-data="sidebar(<expanded>)"; children read
// `expanded` (desktop collapse, persisted in the sidebar_state cookie) and
// `mobileOpen` (mobile sheet). Mod+B toggles; Escape / backdrop close the
// mobile sheet.

// SidebarSide is the edge (default Left).
type SidebarSide int

const (
	SidebarLeft SidebarSide = iota
	SidebarRight
)

func (s SidebarSide) name() string {
	if s == SidebarRight {
		return "right"
	}
	return "left"
}

// SidebarVariant is the panel style.
type SidebarVariant int

const (
	SidebarDefault SidebarVariant = iota
	SidebarFloating
	SidebarVariantInset
)

func (v SidebarVariant) name() string {
	return [...]string{"sidebar", "floating", "inset"}[v]
}

// SidebarCollapsible is how the desktop sidebar collapses.
type SidebarCollapsible int

const (
	SidebarOffcanvas SidebarCollapsible = iota
	SidebarCollapseIcon
	SidebarCollapseNone
)

func (c SidebarCollapsible) name() string {
	return [...]string{"offcanvas", "icon", "none"}[c]
}

// SidebarCookie stores "expanded" / "collapsed" for seven days.
const SidebarCookie = "sidebar_state"

type SidebarProviderProps struct {
	// Expanded is the server-side state read from the sidebar_state cookie.
	Expanded bool
	Class    string
	Attrs    templ.Attributes
}

templ SidebarProvider(p SidebarProviderProps) {
	<div
		data-sidebar="provider"
		x-data={ "sidebar(" + boolStr(p.Expanded) + ")" }
		class={ Cn("flex min-h-svh w-full md:h-svh md:overflow-hidden [--sidebar-width:16rem] [--sidebar-width-mobile:18rem] [--sidebar-width-icon:3rem] md:has-[[data-variant=inset]]:bg-sidebar", p.Class) }
		{ attrs(p.Attrs)... }
	>
		{ children... }
	</div>
}

const sidebarPanelTheme = "[--background:var(--sidebar)] [--foreground:var(--sidebar-foreground)] [--card:var(--sidebar)] [--card-foreground:var(--sidebar-foreground)] [--primary:var(--sidebar-primary)] [--primary-foreground:var(--sidebar-primary-foreground)] [--border:var(--sidebar-border)] [--ring:var(--sidebar-ring)] [--muted-foreground:color-mix(in_oklab,var(--sidebar-foreground)_70%,transparent)]"

type SidebarProps struct {
	Side        SidebarSide
	Variant     SidebarVariant
	Collapsible SidebarCollapsible
	// Expanded is the server-rendered desktop state (match the provider).
	Expanded   bool
	Class      string
	Attrs      templ.Attributes
	SheetClass string
	SheetAttrs templ.Attributes
}

func sidebarAsideClass(p SidebarProps) string {
	width := "md:data-[collapsible=icon]:w-(--sidebar-width-icon)"
	if p.Variant == SidebarFloating {
		width = "md:p-2 md:data-[collapsible=icon]:w-[calc(var(--sidebar-width-icon)+1rem+2px)] md:data-[collapsible=offcanvas]:px-0"
	}
	return Cn("group/sidebar relative z-30 w-0 shrink-0 text-sidebar-foreground md:sticky md:top-0 md:h-svh md:w-(--sidebar-width) md:self-start md:transition-[width] md:duration-200 md:data-[collapsible=offcanvas]:w-0 motion-reduce:transition-none",
		width, If(p.Variant == SidebarVariantInset, "md:py-2"), p.Class)
}

func sidebarPanelClass(v SidebarVariant) string {
	return Cn(sidebarPanelTheme,
		"relative [&]:w-(--sidebar-width-mobile) [&]:max-w-[calc(100vw-3rem)] [&]:gap-0 [&]:overflow-hidden [&]:p-0 md:[&]:w-full md:[&]:max-w-none md:[&]:overflow-visible md:[&]:translate-x-0 md:[&]:transition-none motion-reduce:transition-none",
		[...]string{"md:shadow-none", "md:rounded-xl md:border md:shadow-sm", "md:border-0 md:bg-transparent md:shadow-none"}[v])
}

func sidebarState(expanded bool) string {
	if expanded {
		return "expanded"
	}
	return "collapsed"
}

func sidebarCollapsedAttr(expanded bool, c SidebarCollapsible) string {
	if expanded || c == SidebarCollapseNone {
		return ""
	}
	return c.name()
}

// Sidebar is the panel: a sheet on mobile, a sticky column on desktop.
templ Sidebar(p SidebarProps) {
	{{ expanded := p.Expanded || p.Collapsible == SidebarCollapseNone }}
	<aside
		data-sidebar="sidebar"
		data-side={ p.Side.name() }
		data-variant={ p.Variant.name() }
		data-state={ sidebarState(expanded) }
		data-collapsible={ sidebarCollapsedAttr(expanded, p.Collapsible) }
		if p.Collapsible != SidebarCollapseNone {
			x-bind:data-state="expanded ? 'expanded' : 'collapsed'"
			x-bind:data-collapsible={ "expanded ? '' : '" + p.Collapsible.name() + "'" }
		}
		class={ sidebarAsideClass(p) }
		{ attrs(p.Attrs)... }
	>
		@Sheet(OverlayProps{
			XOpen:   "mobileOpen",
			OnClose: "mobileOpen = false",
			Class:   Cn("md:relative md:inset-auto md:flex md:overflow-visible md:bg-transparent md:opacity-100 md:backdrop-blur-none md:starting:open:opacity-100 md:transition-none md:group-data-[collapsible=offcanvas]/sidebar:invisible motion-reduce:transition-none", p.SheetClass),
			Attrs:   withAttr(withAttr(p.SheetAttrs, "role", "navigation"), "aria-label", "Menu lateral"),
		}) {
			@SheetContent(SheetContentProps{Side: p.Side.sheet(), Class: sidebarPanelClass(p.Variant), Attrs: Attr("data-sidebar", "panel")}) {
				{ children... }
			}
		}
	</aside>
}

// SidebarTrigger toggles the sidebar (desktop collapse / mobile sheet).
// With shortcut, Mod+B (⌘B / Ctrl+B) triggers it and a tooltip shows.
templ SidebarTrigger(shortcut bool, p Props) {
	if shortcut {
		@Tooltip(Props{}) {
			@Button(ButtonProps{Variant: ButtonGhost, Size: ButtonIcon, Class: p.Class, Attrs: sidebarTriggerAttrs(p.Attrs, true)}) {
				@Icon("panel-left", "")
			}
			@TooltipContent(TooltipContentProps{Side: TooltipBottom, Align: TooltipStart, Class: "inline-flex items-center gap-2"}) {
				Alterar menu lateral
				@KbdGroup(Props{}) {
					@Kbd(Props{Attrs: Attr("data-mod-key", "ctrl")}) {
						Ctrl
					}
					@Kbd(Props{}) {
						B
					}
				}
			}
		}
	} else {
		@Button(ButtonProps{Variant: ButtonGhost, Size: ButtonIcon, Class: p.Class, Attrs: sidebarTriggerAttrs(p.Attrs, false)}) {
			@Icon("panel-left", "")
		}
	}
}

func sidebarTriggerAttrs(a templ.Attributes, shortcut bool) templ.Attributes {
	out := withAttr(a, "type", "button")
	out["data-sidebar"] = "trigger"
	out["aria-label"] = "Alternar menu lateral"
	out["x-on:click"] = "toggle()"
	out["x-bind:aria-expanded"] = "String(expanded)"
	if shortcut {
		out["data-sidebar-shortcut"] = "mod+b"
	}
	return out
}

// SidebarRail is the thin desktop edge that toggles the sidebar.
templ SidebarRail(p Props) {
	<button
		type="button"
		data-sidebar="rail"
		aria-label="Alternar menu lateral"
		title="Alternar menu lateral"
		x-on:click="toggle()"
		x-bind:aria-expanded="String(expanded)"
		class={ Cn("absolute inset-y-0 z-10 hidden w-2 cursor-pointer outline-none after:absolute after:inset-y-0 after:w-px hover:after:bg-sidebar-border focus-visible:after:bg-sidebar-ring md:block group-data-[side=left]/sidebar:right-0 group-data-[side=left]/sidebar:after:right-0 group-data-[side=right]/sidebar:left-0 group-data-[side=right]/sidebar:after:left-0", p.Class) }
		{ attrs(p.Attrs)... }
	></button>
}

templ SidebarInset(p Props) {
	<main data-sidebar="inset" class={ Cn("relative flex min-w-0 flex-1 flex-col bg-background md:min-h-0 md:overflow-y-auto [&>[data-sidebar=header]]:sticky [&>[data-sidebar=header]]:top-0 [&>[data-sidebar=header]]:z-20 [&>[data-sidebar=header]]:flex-row [&>[data-sidebar=header]]:items-center [&>[data-sidebar=header]]:justify-start [&>[data-sidebar=header]]:gap-3 [&>[data-sidebar=header]]:bg-background [&>[data-sidebar=header]]:px-4 [&>[data-sidebar=header]>[aria-orientation=vertical]]:h-4 md:in-[[data-sidebar=provider]:has([data-variant=floating])]:my-[calc(--spacing(2)+1px)] md:in-[[data-sidebar=provider]:has([data-variant=inset])]:m-2 md:in-[[data-sidebar=provider]:has([data-variant=inset][data-side=left])]:ml-0 md:in-[[data-sidebar=provider]:has([data-variant=inset][data-side=right])]:mr-0 md:in-[[data-sidebar=provider]:has([data-variant=inset])]:rounded-xl md:in-[[data-sidebar=provider]:has([data-variant=inset])]:shadow-sm md:in-[[data-sidebar=provider]:has([data-variant=inset])]:ring-1 md:in-[[data-sidebar=provider]:has([data-variant=inset])]:ring-sidebar-border", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</main>
}

templ SidebarHeader(p Props) {
	<div data-sidebar="header" class={ Cn("flex h-14 shrink-0 flex-col justify-center gap-2 border-b border-border px-2", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</div>
}

templ SidebarFooter(p Props) {
	<div data-sidebar="footer" class={ Cn("flex shrink-0 flex-col gap-2 p-2", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</div>
}

templ SidebarContent(p Props) {
	<div data-sidebar="content" class={ Cn("flex min-h-0 flex-1 flex-col gap-2 overflow-x-hidden overflow-y-auto overscroll-contain", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</div>
}

templ SidebarGroup(p Props) {
	<div data-sidebar="group" class={ Cn("relative flex min-w-0 flex-col gap-1 p-2", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</div>
}

templ SidebarGroupLabel(p Props) {
	<div data-sidebar="group-label" class={ Cn("flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium text-sidebar-foreground/70 md:group-data-[collapsible=icon]/sidebar:hidden", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</div>
}

const sidebarAction = "absolute flex size-6 items-center justify-center rounded-md text-sidebar-foreground/70 outline-none hover:bg-sidebar-accent/50 hover:text-sidebar-accent-foreground focus-visible:ring-2 focus-visible:ring-sidebar-ring disabled:pointer-events-none disabled:opacity-50 md:group-data-[collapsible=icon]/sidebar:hidden [&_svg]:size-4"

templ SidebarGroupAction(p Props) {
	<button type="button" data-sidebar="group-action" class={ Cn(sidebarAction, "top-3 right-3", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</button>
}

templ SidebarGroupContent(p Props) {
	<div data-sidebar="group-content" class={ Cn("w-full text-sm", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</div>
}

templ SidebarMenu(p Props) {
	<ul data-sidebar="menu" class={ Cn("flex min-w-0 flex-col gap-1", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</ul>
}

templ SidebarMenuItem(p Props) {
	<li data-sidebar="menu-item" class={ Cn("group/menu-item relative", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</li>
}

templ SidebarInput(p InputProps) {
	@Input(InputProps{Invalid: p.Invalid, Class: Cn("bg-background md:group-data-[collapsible=icon]/sidebar:hidden", p.Class), Attrs: withAttr(p.Attrs, "data-sidebar", "input")})
}

templ SidebarSeparator(p Props) {
	@Separator(false, Props{Class: p.Class, Attrs: withAttr(p.Attrs, "data-sidebar", "separator")})
}

// SidebarMenuButtonVariant is the menu button style.
type SidebarMenuButtonVariant int

const (
	SidebarMenuButtonDefault SidebarMenuButtonVariant = iota
	SidebarMenuButtonOutline
)

// SidebarMenuButtonSize is the menu button size (default Md).
type SidebarMenuButtonSize int

const (
	SidebarMenuButtonMd SidebarMenuButtonSize = iota
	SidebarMenuButtonSm
	SidebarMenuButtonLg
)

func (s SidebarMenuButtonSize) classes() string {
	return [...]string{"h-8 text-sm", "h-7 text-xs", "h-12 text-sm"}[s]
}

const sidebarMenuButton = "flex w-full min-w-0 items-center gap-2 overflow-hidden rounded-md border px-2 text-left outline-none transition-colors hover:bg-sidebar-accent/50 hover:text-sidebar-accent-foreground active:bg-sidebar-accent active:text-sidebar-accent-foreground focus-visible:ring-2 focus-visible:ring-sidebar-ring disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50 data-[active=true]:bg-sidebar-accent data-[active=true]:text-sidebar-accent-foreground data-[active=true]:font-medium has-[+[data-sidebar=menu-action]]:pr-8 has-[+[data-sidebar=menu-badge]]:pr-8 [&>svg]:size-4 [&>svg]:shrink-0 [&>span:last-child]:truncate md:group-data-[collapsible=icon]/sidebar:size-8 md:group-data-[collapsible=icon]/sidebar:justify-center md:group-data-[collapsible=icon]/sidebar:p-0 md:group-data-[collapsible=icon]/sidebar:[&>span:last-child]:sr-only"

// SidebarMenuButtonVariants styles another element as a menu button.
func SidebarMenuButtonVariants(v SidebarMenuButtonVariant, s SidebarMenuButtonSize, extra ...string) string {
	vc := "border-transparent"
	if v == SidebarMenuButtonOutline {
		vc = "border-sidebar-border bg-sidebar shadow-xs"
	}
	return Cn(append([]string{sidebarMenuButton, vc, s.classes()}, extra...)...)
}

type SidebarMenuButtonProps struct {
	Variant SidebarMenuButtonVariant
	Size    SidebarMenuButtonSize
	Active  bool
	// Href renders an <a>; empty renders a <button type="button">.
	Href    string
	Tooltip string
	Class   string
	Attrs   templ.Attributes
}

templ SidebarMenuButton(p SidebarMenuButtonProps) {
	if p.Href != "" {
		<a
			href={ templ.SafeURL(p.Href) }
			data-sidebar="menu-button"
			data-active={ boolStr(p.Active) }
			if p.Active {
				aria-current="page"
			}
			if p.Tooltip != "" {
				title={ p.Tooltip }
			}
			class={ SidebarMenuButtonVariants(p.Variant, p.Size, p.Class) }
			{ attrs(p.Attrs)... }
		>
			{ children... }
		</a>
	} else {
		<button
			type="button"
			data-sidebar="menu-button"
			data-active={ boolStr(p.Active) }
			if p.Active {
				aria-current="page"
			}
			if p.Tooltip != "" {
				title={ p.Tooltip }
			}
			class={ SidebarMenuButtonVariants(p.Variant, p.Size, p.Class) }
			{ attrs(p.Attrs)... }
		>
			{ children... }
		</button>
	}
}

templ SidebarMenuAction(showOnHover bool, p Props) {
	<button type="button" data-sidebar="menu-action" class={ Cn(sidebarAction, "top-1 right-1", If(showOnHover, "md:opacity-0 md:group-hover/menu-item:opacity-100 md:group-focus-within/menu-item:opacity-100"), p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</button>
}

templ SidebarMenuBadge(p Props) {
	<span data-sidebar="menu-badge" class={ Cn("pointer-events-none absolute top-1 right-1 flex h-6 min-w-6 items-center justify-center rounded-md px-1 text-xs tabular-nums text-sidebar-foreground/70 md:group-data-[collapsible=icon]/sidebar:hidden", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</span>
}

templ SidebarMenuSkeleton(showIcon bool, p Props) {
	<div data-sidebar="menu-skeleton" aria-hidden="true" class={ Cn("flex h-8 items-center gap-2 rounded-md px-2", p.Class) } { attrs(p.Attrs)... }>
		if showIcon {
			@Skeleton(Props{Class: "size-4 shrink-0"})
		}
		@Skeleton(Props{Class: "h-4 w-3/4 md:group-data-[collapsible=icon]/sidebar:hidden"})
	</div>
}

templ SidebarMenuSub(p Props) {
	<ul data-sidebar="menu-sub" class={ Cn("mx-3.5 flex min-w-0 flex-col gap-1 border-l border-sidebar-border px-2.5 py-1 md:group-data-[collapsible=icon]/sidebar:hidden", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</ul>
}

templ SidebarMenuSubItem(p Props) {
	<li data-sidebar="menu-sub-item" class={ Cn("relative", p.Class) } { attrs(p.Attrs)... }>
		{ children... }
	</li>
}

templ SidebarMenuSubButton(href templ.SafeURL, active bool, size SidebarMenuButtonSize, p Props) {
	<a
		href={ href }
		data-sidebar="menu-sub-button"
		if active {
			aria-current="page"
		}
		class={ Cn("flex min-w-0 items-center gap-2 rounded-md px-2 text-sidebar-foreground/70 outline-none hover:bg-sidebar-accent/50 hover:text-sidebar-accent-foreground focus-visible:ring-2 focus-visible:ring-sidebar-ring aria-[current=page]:bg-sidebar-accent aria-[current=page]:text-sidebar-accent-foreground aria-disabled:pointer-events-none aria-disabled:opacity-50 [&>svg]:size-4 [&>svg]:shrink-0 [&>span:last-child]:truncate", size.classes(), p.Class) }
		{ attrs(p.Attrs)... }
	>
		{ children... }
	</a>
}
