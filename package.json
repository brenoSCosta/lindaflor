{
  "name": "lindaflor",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "3.21.3",
      "zod": "4.4.3",
      "typescript": "7.0.2",
      "tsdown": "0.22.4",
      "date-fns": "4.4.0",
      "date-fns-tz": "3.2.0",
      "@tanstack/react-form": "1.33.0",
      "@tanstack/react-table": "8.21.3",
      "@tanstack/react-query": "5.90.21",
      "@orpc/client": "1.14.3",
      "@orpc/openapi": "1.14.3",
      "@orpc/server": "1.14.3",
      "@orpc/tanstack-query": "1.14.3",
      "@orpc/zod": "1.14.3",
      "@orpc/contract": "1.14.3",
      "@orpc/experimental-ratelimit": "1.14.3",
      "@types/bun": "1.3.14",
      "@types/pg": "8.20.0",
      "@types/uuid": "11.0.0",
      "better-auth": "1.6.23",
      "dotenv": "17.4.2",
      "drizzle-orm": "0.45.2",
      "elysia": "1.4.29",
      "iovalkey": "0.3.3",
      "jspdf": "4.2.1",
      "jspdf-autotable": "5.0.8",
      "xlsx": "0.18.5",
      "@casl/ability": "7.0.1",
      "@casl/react": "7.0.1",
      "@ucast/core": "2.0.0",
      "uuid": "14.0.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "oxlint --type-aware --type-check && oxfmt --write .",
    "check-types": "turbo check-types",
    "clean": "turbo clean",
    "clean-root": "rm -rf node_modules .turbo",
    "test": "turbo test",
    "test-e2e": "turbo -F @lindaflor/e2e test-e2e --",
    "test-video": "turbo -F @lindaflor/e2e test-video",
    "contract-gen": "turbo -F @lindaflor/api contract-gen",
    "sync": "bun update --interactive --recursive --latest",
    "prebuild": "turbo prebuild",
    "dev-android": "turbo -F @lindaflor/native android",
    "dev-native": "turbo -F @lindaflor/native native",
    "dev-web": "turbo -F @lindaflor/web dev",
    "dev-server": "turbo -F @lindaflor/server dev",
    "db-push": "turbo -F @lindaflor/db db-push",
    "db-check": "turbo -F @lindaflor/db db-check",
    "db-studio": "turbo -F @lindaflor/db db-studio",
    "db-gen": "turbo -F @lindaflor/db db-gen --",
    "db-migrate": "turbo -F @lindaflor/db db-migrate",
    "db-migrate:run": "turbo -F @lindaflor/db db-migrate:run",
    "db-seed": "turbo -F @lindaflor/server db-seed",
    "db-randomize-stock": "turbo -F @lindaflor/server db-randomize-stock",
    "docker-dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker-dev:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "docker-build": "DOCKER_BUILDKIT=1 docker compose build --progress=plain && docker compose up -d",
    "docker-down": "docker compose down -v",
    "docker-clean": "docker compose down -v && docker system prune --all && docker system prune --volumes",
    "auth-gen": "bun x @better-auth/cli generate --config ./packages/auth/src/index.ts",
    "prepare": "husky",
    "publish": "changeset publish",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@changesets/get-github-info": "0.8.0",
    "@changesets/types": "6.1.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@lindaflor/config": "workspace:*",
    "@sinclair/typebox": "0.34.49",
    "@tanstack/eslint-plugin-query": "5.101.2",
    "@types/bun": "catalog:",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-doctor": "0.7.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.1",
    "eslint-plugin-use-no-memo": "1.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "tsdown": "catalog:",
    "turbo": "2.9.14",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "oxlint --type-aware --type-check",
      "oxfmt --write ."
    ],
    "*.{json,jsonc,md,mdc,mdx}": [
      "oxfmt --write ."
    ],
    "*": "sh -c 'turbo boundaries'"
  },
  "engines": {
    "bun": ">=1.4.0",
    "npm": "this-project-uses-bun",
    "pnpm": "this-project-uses-bun",
    "yarn": "this-project-uses-bun"
  },
  "packageManager": "bun@1.3.10"
}
