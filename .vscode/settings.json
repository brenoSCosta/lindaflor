{
  "go.useLanguageServer": true,
  "go.alternateTools": {
    "go": "${workspaceFolder}/.devenv/profile/bin/go",
    "gopls": "${workspaceFolder}/.devenv/profile/bin/gopls"
  },
  "go.toolsEnvVars": {
    "GOTOOLCHAIN": "local"
  },
  "go.lintTool": "golangci-lint-v2",
  "go.lintFlags": ["--fast-only"],
  "gopls": {
    "formatting.gofumpt": true,
    "build.buildFlags": []
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[templ]": {
    "editor.defaultFormatter": "a-h.templ",
    "editor.formatOnSave": true
  },
  "templ.goplsOptions": {},
  "tailwindCSS.includeLanguages": {
    "templ": "html"
  },
  "tailwindCSS.experimental.configFile": "web/styles/input.css",
  "emmet.includeLanguages": {
    "templ": "html"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.watcherExclude": {
    "**/.devenv/**": true,
    "**/.direnv/**": true,
    "**/.git/**": true
  },
  "search.exclude": {
    "**/*_templ.go": true,
    "internal/db/sqlc/**": true,
    "web/static/css/app.css": true,
    "web/static/vendor/**": true,
    "**/*.lock": true,
    "go.sum": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.compactFolders": true,
  "explorer.fileNesting.patterns": {
    "*.templ": "${capture}_templ.go",
    "go.mod": "go.sum",
    "flake.nix": "flake.lock",
    "devenv.nix": "devenv.lock, devenv.yaml"
  }
}
