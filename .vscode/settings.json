{
  "editor.defaultFormatter": "rust-lang.rust-analyzer",
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[json]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[markdown]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "rust-analyzer.linkedProjects": ["Cargo.toml"],
  "rust-analyzer.server.path": "${workspaceFolder}/.devenv/profile/bin/rust-analyzer",
  "rust-analyzer.cargo.targetDir": true,
  "rust-analyzer.server.extraEnv": {
    "PATH": "${workspaceFolder}/.devenv/profile/bin:${env:PATH}",
    "PKG_CONFIG_PATH": "${workspaceFolder}/.devenv/profile/lib/pkgconfig",
    "LD_LIBRARY_PATH": "${workspaceFolder}/.devenv/profile/lib:${env:LD_LIBRARY_PATH}",
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:4201/topcoat"
  },
  "rust-analyzer.cargo.extraEnv": {
    "PATH": "${workspaceFolder}/.devenv/profile/bin:${env:PATH}",
    "PKG_CONFIG_PATH": "${workspaceFolder}/.devenv/profile/lib/pkgconfig",
    "LD_LIBRARY_PATH": "${workspaceFolder}/.devenv/profile/lib:${env:LD_LIBRARY_PATH}",
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:4201/topcoat"
  },
  "rust-analyzer.check.extraEnv": {
    "PATH": "${workspaceFolder}/.devenv/profile/bin:${env:PATH}",
    "PKG_CONFIG_PATH": "${workspaceFolder}/.devenv/profile/lib/pkgconfig",
    "LD_LIBRARY_PATH": "${workspaceFolder}/.devenv/profile/lib:${env:LD_LIBRARY_PATH}",
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:4201/topcoat"
  },
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.procMacro.enable": true,
  "rust-analyzer.cargo.buildScripts.enable": true,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.watcherExclude": {
    "**/target/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/target": true,
    "**/*.lock": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.compactFolders": true,
  "explorer.fileNesting.patterns": {
    "package.json": "*.ts, *.lock",
    "flake.nix": "*.lock, *.toml, *.yml, *.yaml, .*, *.md, *.html, *.rdb, *.rs, *.css, *.nix"
  }
}
