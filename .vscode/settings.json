{
  "editor.defaultFormatter": "rust-lang.rust-analyzer",
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[json]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[markdown]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "rust-analyzer.files.exclude": [
    "target",
    ".git",
    ".github",
    "node_modules",
    "dist",
    "build"
  ],
  "rust-analyzer.files.watcher": "server",
  "rust-analyzer.cargo.autoreload": true,
  "rust-analyzer.cargo.buildScripts.enable": false,
  "rust-analyzer.cargo.noDeps": true,
  "rust-analyzer.checkOnSave": false,
  "rust-analyzer.procMacro.enable": false,
  "rust-analyzer.inlayHints.enable": false,
  "rust-analyzer.lens.enable": false,
  "rust-analyzer.completion.autoimport.enable": false,
  "rust-analyzer.diagnostics.enable": true,
  "rust-analyzer.diagnostics.experimental.enable": false,
  // Disable caching
  "rust-analyzer.cachePriming.enable": false,
  "rust-analyzer.numThreads": 1,
  "rust-analyzer.lru.capacity": 64,
  "files.exclude": {
    "**/target": true,
    "**/.git": true,
    "**/.github": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  },
  "rust-analyzer.linkedProjects": ["Cargo.toml"],
  "rust-analyzer.server.path": "${workspaceFolder}/.devenv/profile/bin/rust-analyzer",
  "rust-analyzer.cargo.allTargets": false,
  "rust-analyzer.cargo.targetDir": true,
  "rust-analyzer.server.extraEnv": {
    "PATH": "${workspaceFolder}/.devenv/profile/bin:${env:PATH}",
    "PKG_CONFIG_PATH": "${workspaceFolder}/.devenv/profile/lib/pkgconfig",
    "LD_LIBRARY_PATH": "${workspaceFolder}/.devenv/profile/lib:${env:LD_LIBRARY_PATH}",
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:4201/topcoat",
    "SQLX_OFFLINE": "true"
  },
  "rust-analyzer.cargo.extraEnv": {
    "PATH": "${workspaceFolder}/.devenv/profile/bin:${env:PATH}",
    "PKG_CONFIG_PATH": "${workspaceFolder}/.devenv/profile/lib/pkgconfig",
    "LD_LIBRARY_PATH": "${workspaceFolder}/.devenv/profile/lib:${env:LD_LIBRARY_PATH}",
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:4201/topcoat",
    "SQLX_OFFLINE": "true"
  },
  "rust-analyzer.check.extraEnv": {
    "PATH": "${workspaceFolder}/.devenv/profile/bin:${env:PATH}",
    "PKG_CONFIG_PATH": "${workspaceFolder}/.devenv/profile/lib/pkgconfig",
    "LD_LIBRARY_PATH": "${workspaceFolder}/.devenv/profile/lib:${env:LD_LIBRARY_PATH}",
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:4201/topcoat",
    "SQLX_OFFLINE": "true"
  },
  "rust-analyzer.check.command": "check",
  "rust-analyzer.check.extraArgs": ["--bin", "lindaflor"],
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.watcherExclude": {
    "**/target/**": true,
    "**/node_modules/**": true,
    "**/.sqlx/**": true,
    "**/.git/**": true,
    "**/.github/**": true,
    "**/dist/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/target": true,
    "**/.sqlx": true,
    "**/*.lock": true,
    "**/target/**": true,
    "**/.git/**": true,
    "**/.github/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.compactFolders": true,
  "explorer.fileNesting.patterns": {
    "package.json": "*.ts, *.lock",
    "flake.nix": "*.lock, *.toml, *.yml, *.yaml, .*, *.md, *.html, *.rdb, *.rs, *.css, *.nix"
  }
}
